{
  "name": "autom8-frontend",
  "version": "1.0.0",
  "description": "Autom8 Restaurant Management System - Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ src-autom8-owner/ src-register/",
    "lint:fix": "eslint --fix src/ src-autom8-owner/ src-register/",
    "start": "serve -s dist -l 3000",
    "build:register": "npx vite build --config vite.register.config.js",
    "build:autom8-owner": "npx vite build --config vite.autom8-owner.config.js && node -e \"require('fs').copyFileSync('src-autom8-owner/index.html','dist-autom8-owner/index.html')\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.6.0",
    "chart.js": "^4.4.1",
    "date-fns": "^2.30.0",
    "lucide-react": "^1.21.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.18.0",
    "serve": "^14.2.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
